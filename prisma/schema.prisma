// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ticket {
  id          String   @id @default(cuid())
  ticketId    String   @unique // e.g. TKT-1001
  title       String
  description String
  priority    Priority @default(MEDIUM)
  status      Status   @default(OPEN)
  category    Category @default(SOFTWARE)
  requester   String
  assignee    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([category])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Category {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCESS
  OTHER
}
